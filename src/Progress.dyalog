  '    let id = setInterval(frame, 1);'
  '    function frame() {'
  '      if (width >= 100) {'
  '        clearInterval(id);'
  '      } else {'
  '        width++;'
  '        elem.style.width = width + "%";'
  '        elem.innerHTML = width + "%";'
  '      }'
  '    }'
  '  }'
  '  move()'
