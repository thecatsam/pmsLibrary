     ∇ r←{start}isolate.RPCServer.Run args;sink;done;data;event;obj;rc;wait;z;cmd;name;port;protocol;srvparams;msg;rt;quiet;autoshut;tid;addr;ok;i;filter;first;⎕TRAP
[1]   ⍝ Run a Simple RPC Server
[2]   
[3]   (name port)←2↑args
[4]   srvparams←2↓args
[5]   
[6]   :If 0=⎕NC'start' ⋄ start←1 ⋄ :EndIf         ⍝ start may be (start quiet)
[7]   rt←'R'∊'.'⎕WG'APLVersion'                   ⍝ Runtime or DLLRT
[8]   (start quiet autoshut)←0 rt 0∨3↑start
[9]   {}##.DRC.Init''
[10]   :If (⊂Protocol)∊'IPv4' 'IPv6' ⋄ ##.DRC.SetProp'.' 'Protocol'Protocol ⋄ :EndIf
[11]  
[12]   :If start
[13]   :If 0≠1⊃r←##.DRC.Srv(name''port'Command'),srvparams ⋄ :Return ⋄ :EndIf ⍝ Exit if unable to start server
[14]   :If ~rt ⋄ tid←0 quiet autoshut Run&name port
[15]   ⍝ Above line may start handler on separate thread
[16]   ⍝ /// Looks like a bug to Morten if your application is in a runtime
[17]   ⍝ /// That should probably only be done if BOOTING in a runtime
[18]   ⍪quiet↓⊂'Server ''',name,''', listening on port ',⍕port
[19]   ⍪quiet↓⊂' Handler thread started: ',⍕tid
[20]   r←0 tid
[21]   :Return ⍝ New TID
[22]   :EndIf
[23]   :EndIf
[24]  
[25]   ⍝ Handle the server (maybe in a new thread)
[26]   ⍪quiet↓⊂'Thread ',(⍕⎕TID),' is now handling server ''',name,'''.'
[27]   done←0 ⍝ Done←1 in function "End"
[28]   first←''
[29]  
[30]   :While ~done
[31]   :Trap 1002 1003 ⍝ trap weak and strong interrupts - on UNIX kill -2 and kill -3
[32]  
[33]   rc obj event data←4↑wait←##.DRC.Wait name 10000 ⍝ Time out now and again
[34]  
[35]   :Select rc
[36]   :Case 0
[37]   :Select event
[38]   :Case 'Error'
[39]   ⍪quiet↓⊂'Error ',(⍕data),' on ',obj
[40]   :If ~done∨←(⊂obj)∊name first ⍝ Error on the listener or 1st connection?
[41]   {}##.DRC.Close obj ⍝ Close connection in error
[42]   :EndIf
[43]  
[44]   :If autoshut=1
[45]   :AndIf 0=#.DRC.Exists first
[46]   ⍪quiet↓⊂'First connection lost - AutoShut initiated'
[47]   done←1 ⋄ autoshut←2
[48]   :EndIf
[49]  
[50]   :Case 'Receive'
[51]   :If 2≠⍴data ⍝ Command is expected to be (function name)(argument)
[52]   {}##.DRC.Respond obj(99999 'Bad command format') ⋄ :Leave
[53]   :EndIf
[54]  
[55]   :If 3≠⎕NC cmd←1⊃data ⍝ Command is expected to be a function in this ws
[56]   {}##.DRC.Respond obj(99999('Illegal command: ',cmd)) ⋄ :Leave
[57]   :EndIf
[58]  
[59]   Process&obj data ⍝ Handle each call in new thread
[60]  
[61]   :Case 'Connect' ⍝ Set 'KeepAlive' to 10 seconds so we discover IP disconnections
[62]   first,←(0=⍴first)/obj ⍝ bond to parent
[63]   {}##.DRC.SetProp obj'KeepAlive' 10000 10000
[64]   addr←{(-(⌽⍵)⍳':')↓⍵}2 2⊃##.DRC.GetProp obj'PeerAddr'
[65]   addr←addr~'[]'
[66]   addr←(7×'::ffff:'≡7↑addr)↓addr ⍝ IPv4 wrapped in IPv6
[67]  
[68]   :If ~ok←(⊂addr)∊localaddrs[;2] ⍝ remote
[69]   :For i :In ⍳≢allowremote
[70]   :Select 3↑filter←i⊃allowremote
[71]   :CaseList 'ip=' 'IP=' ⍝ ip address
[72]   :If ok←ok∨addr{⍵≡(⍴⍵)↑⍺}3↓filter ⋄ :Leave ⋄ :EndIf
[73]   :EndSelect
[74]   :EndFor
[75]  
[76]   :AndIf ~ok ⍝ Still not OK
[77]   Log'Connection refused from: ',addr
[78]   Log'Filters: 'allowremote
[79]   {}##.DRC.Close obj ⍝ 'bye
[80]   :EndIf
[81]  
[82]   :Case 'Timeout' ⍝ Eventmode Timeout - see 100 below
[83]  
[84]   :Else ⍝ Unexpected result? should NEVER happen
[85]   ⎕←'Unexpected result "',event,'" from object "',name,'" - RPC Server shutting down' ⋄ done←1
[86]  
[87]   :EndSelect
[88]  
[89]   :Case 100  ⍝ Time out - Insert code for housekeeping tasks here
[90]  
[91]   :Case 1010 ⍝ Object Not Found
[92]   ⎕←'Server object ''',name,''' has been closed - RPC Server shutting down' ⋄ done←1
[93]  
[94]   :Else
[95]   ⎕←'Error in RPC.Wait: ',⍕wait
[96]   :EndSelect
[97]   :Else ⍝ got an interrupt
[98]   ⎕←((1002 1003⍳⎕EN)⊃'Weak' 'Strong' 'Unknown?'),' interrupt received, RPC Server shutting down'
[99]   done←1
[100]   :EndTrap
[101]  :EndWhile
[102]  :If autoshut≠2 ⋄ ⎕DL 1 ⋄ :EndIf ⍝ Give responses time to complete
[103]  {}##.DRC.Close name
[104]  ⍪quiet↓⊂'Server ',name,' terminated.'
     ∇

