 :namespace ∆F_toc 
 
 ∇ ok←Load
   (section target keyword)← ⎕CSV ⍠('Separator' '⋄')('Invert' 2)⊢ '∆F_toc.in' ⍬
   ok← 'Loaded...'
∇

∇ ok← Sort ;p; Cap1
    CapFirst← { (1 ⎕C ⊃⍵), 1↓⍵}
  ⍝ Put $, £, etc. after z.
    src← '[$£→↓%]'  '`⍵' '⍹'  '([`∆])(\w)'  '\(cont.\)'
    snk← '\0'      '⍵' '⍹' '\2\1'        ''
    p← ⍋src ⎕R snk⊢ ⎕C keyword~¨⊂'-,.'
    keyword← CapFirst¨ keyword[p]             ⍝ Capitalise first!
    section← section[p]
    target← target[p]
   ok← 'Sorted...'
∇
 
∇ ok← Fmt 
  ;sn;SetKK;k;t;s; sectWidth
  keyPad← 7+⌈/≢¨keyword

  SectNos← {  ok i← ⎕VFI ⍵ ⋄ ok⊃¯1 i }¨
  Strong←  { '<strong>',⍵,'</strong>'}
  Small←   { '<small><em>',⍵,'</em></small>' }
  Section← { '&emsp;' , (Big 'blue' Color ⍵),'</a><br>' }¨
  Color←   { '<span class="',⍺,'">',⍵,'</span>'}
  Big←     { '<big>',⍵,'</big>'}
  SetKK←  { 
      bigRed← (⍺>0)∧(⍺=⌊⍺)∨⍺=5.5 
      green← ⍺<0
    bigRed: 'red' Color Big ⍵ 
    green:  'green' Color ⍵ 
    ⍵ 
  }
  SetKKE← SetKK¨
⍝ Pad targets to make it easy enough to read in markdown text.
  Targets← { '> ',⍨ t↑⍨ keyPad⌈≢t←'<a href="#',⍵,'"' }¨
  EscapesE← '`' ⎕R '\\`'
 
  sn← SectNos section~¨' '     ⍝ Allows for text in section 'numbers'
  k← EscapesE sn SetKKE Strong¨ keyword 
  t← Targets target  
⍝ Leave Table unabbreviated!
  s← 'Fig.' 'Tbl.' ⎕R (Small¨'Fig.' 'Table') ⊣Section section  
  edited← t,¨k,¨s  
  ok← 'Formatted...' 
∇

∇ ok← Show 
  _← (⊂edited) ⎕NPUT '∆F_toc.out' 1
  _← ⎕ED 'edited'
  ok←'Shown...'
∇

∇ ok← Gen; _Ro; data; fi; fo; ib;ie; nl; now; out; _
  _Ro← ⍠('Mode' 'M')('Regex' (1 0))('DotAll' 1)
  Load ⋄ Sort ⋄ Fmt

  nl← ⎕UCS 10 
  fi← '∆F/∆F_Help.md' 
  ⎕SH 'cp ∆F/∆F_Help.md ∆F_Help_tmp.md'
  fo← '∆F/∆F_Help.md'

  data← ∊ edited,¨nl 

  ib ie← '<!-- INDEX_BEGIN -->'  '<!-- INDEX_END -->'
  now← ∊∆F'{ `T ⎕TS }'
  out← (ib,'.*?',ie) ⎕R (ib,'<!-- Generated by ∆F_toc: ',now,' -->',nl,data,ie)_Ro ⊃⎕NGET fi 1
  _← (⊂out) ⎕NPUT fo 1  
  ok← 'Generated!'
∇

⎕←'∆F_toc.( Load ⋄ Sort ⋄ Fmt)'  
⎕←'∆F_toc.Gen     ⍝ Does all this and generates new ∆F_Help.md'
:endNamespace  
