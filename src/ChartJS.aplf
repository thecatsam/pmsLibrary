∇ {hr}← {opts}ChartJS values
        ; anim; big; chartLocal; chartCd; chartParms; chartSrcNm
        ; eLines; hLines; hr; html; i; j; labels; ln; opts; p; path; posn; print
        ; rc; seg; size; src; title; type; wait; xl; yl; yz; ∆
        ; GetHtml; NumObj; PrintToPDF; Seg; TexMix; WaitForLoad
        ; _Ro
        ; ⎕IO; ⎕ML
      
   ⍝ Draw a chart using Chart.js via HtmlRenderer.
   ⍝ Requires Internet access only if no local copy of Chart.js is found (see src).
   ⍝ By default, chart terminates when the namespace returned goes out of scope.
   ⍝ (See options).
   ⍝   options:
   ⍝     An optional namespace containing several variables:
   ⍝       var     description                       default
   ⍝       ¯¯¯¯¯¯¯ ¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯       ¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯
   ⍝       values  the values, if set, replace       ,values
   ⍝               those presented as the right
   ⍝               argument to ChartJS.
   ⍝       type    type of chart, e.g. bar,          'bar'
   ⍝               line, pie, doughnut, etc.
   ⍝       title   the chart title                   'My Chart'
   ⍝       xl      the x-axis label                  'ITEMS'
   ⍝       yl      the y-axis label                  'VALUES'
   ⍝       yz      does the y-axis start at 0        1
   ⍝       labels  a vector containing the           1 2 3 ... ≢values
   ⍝               label for each chart item.
   ⍝       size    Size of the window                40 40
   ⍝       posn    upper LHS corner of window        1  1
   ⍝       print   Print the chart as a pdf          ''
   ⍝               with name <print>.pdf.
   ⍝               Ignored if '' (default).
   ⍝       wait    wait for close before returning.  0
   ⍝       anim    animation time (in ms) to build   1000
   ⍝               the chart; 0 turns it off.
   ⍝               If (×≢print), anim defaults to 0.
   ⍝               Also off for "big" data sets.
   ⍝       src     Where to get Chart.js: a file     ''
   ⍝               path (read and inlined) or an
   ⍝               http(s) URL. '' => use chartLocal
   ⍝               (below), else the CDN.
   ⍝       big     Above this many items (bar/line)  1000
   ⍝               switch to the fast path: no
   ⍝               animation, unparsed data,
   ⍝               decimation for lines.
   ⍝  values:
   ⍝       A vector of real numbers, one per chart item.
   ⍝       Will be replaced by opts.values if defined.
      
      ⎕IO ⎕ML← 0 1
   ⍝  Local copy of Chart.js: save https://cdn.jsdelivr.net/npm/chart.js as a file
   ⍝  and put its full path in chartLocal (or pass opts.src). If the file does
   ⍝  not exist, the CDN below is used as a fallback.
      chartLocal← ''
      chartSrcNm← 'https://cdn.jsdelivr.net/npm/chart.js'
      :If 900⌶0 ⋄ opts← () ⋄ :EndIf
      
   ⍝  Support Functions
      NumObj← {3 5 7 11∊⍨80|⎕DR ⍵}
      WaitForLoad← { ⍵≤ 0: _← 0 ⋄ hr.IsLoading: _← ⍺ ∇ ⍵-⎕DL ⍺ ⋄ _← 1}
      PrintToPDF← {
          11:: ⎕← 'PrintToPDF DOMAIN ERROR: Invalid filename'
            rc← hr.PrintToPDF fi← ⍵,'.pdf'
          1=rc: ⎕← 'Printed ',fi
          1: ⎕← 'Unable to print ',fi
      }
   ⍝  TexMix ⍵@[CV|NS]+
   ⍝     Useful for labels with simple vector of numbers mixed with char vectors.
      TexMix← { 0= ⊃0⍴ ⍵: ⍵ ⋄ '-'@ ('¯'∘=) ,⍕⍵ }¨,∘⊆
      _Ro← ⍠'Regex'(1 0)                     ⍝ Regex pattern; literal replacement
   ⍝  End Support Functions
      
   ⍝  Load defaults => modify by opts => import these variables into this fn's namespace
      ⎕THIS ⎕NS (
         ⍝   var_nm:  default                ⍝ type descr
            values: ,values                  ⍝ NV   Overridden by opts.values, if specified.
            type: 'bar'                      ⍝ CV
            title: 'My Chart'                ⍝ CV
            xl: 'ITEMS'                      ⍝ CV   x label
            yl: 'VALUES'                     ⍝ CV   y label
            yz: 1                            ⍝ B1   Begin y axis at zero?
            labels: ⎕NULL  ⍝ (1+ ⍳≢values)     ⍝ CVV  item labels:
            size: 40 40                      ⍝ I2   On screen
            posn: 1 1                        ⍝ I2   On screen
            anim: 1000                       ⍝ I1   Build time in ms. 0 = no animation
            print: ''                        ⍝ CV   If empty, nothing is printed.
            wait: 0                          ⍝ BS   If 1, wait until window closes to exit.
            src: ''                          ⍝ CV   Chart.js file path or URL ('' => default)
            big: 1000                        ⍝ I1   Item count above which the fast path is used
      ) opts
      anim×← 0=≢print                        ⍝ Printing? Set anim to 0. Chart must be fully drawn at once.
      
      :If ~NumObj values
            11 ⎕SIGNAL⍨'Values must be numbers'
      :EndIf
      
   ⍝  Set labels, if needed
      :If ⎕NULL≡labels
            labels← 1+⍳≢values               ⍝ Values '1' '3' etc.
      :Else
            :If ~NumObj labels               ⍝ Text or mixed Text/Numbers
                  labels← TexMix labels
            :EndIf
            :Select ×∆← values-⍥≢labels      
                :Case  1 ⋄ labels,← ∆⍴⊂''    ⍝  Missing? Pad with empty string
                :Case ¯1 ⋄ labels↑⍨← ≢values ⍝  Extras? Truncate quietly
            :EndSelect
      :EndIf
      
   ⍝  Locate Chart.js: explicit src, else chartLocal, else the CDN.
      :If ×≢src
            :If 'http'≡4↑src
                  chartSrcNm path← src ''
            :Else
                  path← src
            :EndIf
      :Else 
            path← chartLocal 
      :EndIf
      :If ×≢path ⋄ :Andif ⎕NEXISTS path
            chartCd← ⊃⎕NGET path             ⍝ Inline the library: no network, no extra load step
            chartCd← '</script' ⎕R '<\/script' _Ro chartCd
      :Else 
            chartCd← '' 
      :EndIf
      
   ⍝  Chart parameters (JSON). No startDelay: JS now waits for APL's StartChart() call.
      chartParms← ⎕JSON ⍠'Compact' 0 ⊣ (
            title:  title
            xLabel: xl
            yLabel: yl
            yZero:  yz
            anim:   anim
            big:    big
            labels: labels
            type:   type                        ⍝ Chart type
            values: values
      )
      chartParms← '</' ⎕R '<\/' _Ro chartParms ⍝ Keep labels from closing the script tag
      
   ⍝  Extract the embedded HTML/JS in one pass: comment lines tagged with '⍝H'.
      GetHtml← { 
            seg← '^\h*⍝H\h(.*)' ⎕S '\1' ⎕NR ⍵

            s← '_SRC_NM_'
            i← ⊃⍸∨/¨s∘⍷¨ seg                         ⍝ The <script src=...> line
            (i⊃seg)← (×≢chartCd)⊃ ('<script src="',chartSrcNm,'"></script>') ('<script>',chartCd,'</script>')
           
            p← '_PARMS_' 
            i← ⊃⍸∨/¨p∘⍷¨seg                 ⍝ The line holding _PARMS_
            ln← i⊃seg
            j← ⊃⍸p⍷ ln 
            (i⊃seg)← (j↑ln),chartParms,(j+ ≢p)↓ln

            ∊ (⎕UCS 10)∘,¨ seg 
      }
      html← GetHtml 0⊃⎕XSI
      
   ⍝  Start up the Renderer
      'hr'⎕WC(
            'HTMLRenderer' ⋄ 'Visible' 0
            'Size'⊂⍛,size  ⋄ 'Posn'⊂⍛,posn
            'Caption'title ⋄ 'HTML'html
      )
      0.05 WaitForLoad 1 ⋄ hr.Visible← 1     ⍝ Prevents flashing screen.
      
   ⍝  Page is loaded and the chart is built (hidden if animating): tell it to start.
   ⍝  If this call fails, a JS fallback timer starts the chart anyway.
      :Trap 0
            {}hr.ExecuteJavaScript 'StartChart()' ''
      :EndTrap
      
   ⍝  Our work is done...
      {}PrintToPDF⍣(×≢print)⊢print           ⍝ Print the PDF?
      {}⎕DQ⍣wait⊢'hr'                        ⍝ If wait, stop until chart page is closed.
      
   ⍝⍝⍝ HTML/JS Code Segments:  matching /⍝[HDE]\h/ only.
      ⍝ :Section Html/JavaScript Code
         ⍝H <!DOCTYPE html>
         ⍝H  <html>
         ⍝H   <head>
         ⍝H     <script src="_SRC_NM_"></script>
         ⍝H     <style>
         ⍝H       html,body{height:100%;margin:0 ;}
         ⍝H       #chart{width:98vw;height:100%;}
         ⍝H     </style>
         ⍝H   </head>
         ⍝H   <body><div id="chart"></div>
         ⍝
         ⍝H   <script>
         ⍝H   /**
         ⍝H    * DrawChart(spec, containerId) -> {chart, start} or null
         ⍝H    *   spec.labels : array of category names (x axis)
         ⍝H    *   spec.values : array of numbers
         ⍝H    *   spec.xLabel : legend for the x axis
         ⍝H    *   spec.yLabel : legend for the y axis
         ⍝H    *   spec.title  : chart title
         ⍝H    *   spec.type   : Chart.js chart type
         ⍝H    *   spec.yZero  : 1 => y axis begins at zero
         ⍝H    *   spec.anim   : build animation time in ms (0 = none)
         ⍝H    *   spec.big    : item count above which the fast path is used
         ⍝H    * The chart is built immediately (no animation). If animating, the
         ⍝H    * host stays hidden until start() is called, which resets the chart
         ⍝H    * and replays it with the staggered build animation.
         ⍝H    */
         ⍝H   function DrawChart(spec, containerId) {
         ⍝H     const host = document.getElementById(containerId);
         ⍝H     if (typeof Chart === "undefined") {
         ⍝H        host.textContent = "Chart.js failed to load (is the network available?)";
         ⍝H        return null;
         ⍝H     }
         ⍝H     host.innerHTML = "<canvas></canvas>";
         ⍝H     const n = spec.values.length;
         ⍝H     const noXY = ["pie","doughnut","polarArea","radar"].includes(spec.type);
         ⍝H     const big = !noXY && n > spec.big;
         ⍝H     const multi = ["bar","pie","doughnut","polarArea"].includes(spec.type) && !big;
         ⍝H     const isLine = spec.type === "line";
         ⍝H
         ⍝H     // One colour per item for bar/pie/doughnut/polarArea; a single colour otherwise
         ⍝H     const ds = { data: spec.values };
         ⍝H     if (multi) {
         ⍝H       const bg = [], bd = [];
         ⍝H       for (let i = 0; i < n; i++) {
         ⍝H         const hue = Math.floor((i * 360) / n);
         ⍝H         bg.push(`hsl(${hue}, 65%, 55%)`);
         ⍝H         bd.push(`hsl(${hue}, 65%, 40%)`);
         ⍝H       }
         ⍝H       ds.backgroundColor = bg;
         ⍝H       ds.borderColor = bd;
         ⍝H       ds.borderWidth = 1;
         ⍝H     } else {
         ⍝H       ds.backgroundColor = "hsla(210, 65%, 55%, 0.35)";
         ⍝H       ds.borderColor = "hsl(210, 65%, 40%)";
         ⍝H       ds.pointBackgroundColor = "hsl(210, 65%, 40%)";
         ⍝H       ds.borderWidth = (big && !isLine) ? 0 : 2;
         ⍝H       ds.pointRadius = big ? 0 : 3;
         ⍝H     }
         ⍝H     // Big data: hand Chart.js its internal {x,y} format so it can skip parsing
         ⍝H     if (big) ds.data = spec.values.map((y, x) => ({ x: x, y: y }));
         ⍝H
         ⍝H     const axisTitle = t => ({ display: !!t, text: t || "",
         ⍝H                               font: { size: 14, weight: "bold" } });
         ⍝H     const scales = noXY ? {} : {
         ⍝H       x: { title: axisTitle(spec.xLabel) },
         ⍝H       y: { beginAtZero: spec.yZero === 1, title: axisTitle(spec.yLabel) }
         ⍝H     };
         ⍝H     if (big && isLine) {     // decimation needs a linear (or time) x scale
         ⍝H       scales.x.type = "linear";
         ⍝H       scales.x.min = 0;
         ⍝H       scales.x.max = n - 1;
         ⍝H       scales.x.ticks = { callback: v => Number.isInteger(v)
         ⍝H           ? String(spec.labels[v] !== undefined ? spec.labels[v] : v) : "" };
         ⍝H     }
         ⍝H
         ⍝H     // Staggered build animation; per-item delay capped so tiny charts stay snappy
         ⍝H     let delayed = false;
         ⍝H     const perItem = Math.min(spec.anim / Math.max(n, 1), 150);
         ⍝H     const canAnim = spec.anim > 0 && !big;
         ⍝H     const animCfg = {
         ⍝H       duration: spec.anim,
         ⍝H       easing: "easeOutQuart",
         ⍝H       delay: ctx => (ctx.type === "data" && ctx.mode === "default" && !delayed)
         ⍝H                       ? ctx.dataIndex * perItem : 0,
         ⍝H       onComplete: () => { delayed = true; }
         ⍝H     };
         ⍝H     if (canAnim) host.style.visibility = "hidden";
         ⍝H
         ⍝H     const options = {
         ⍝H       responsive: true,
         ⍝H       maintainAspectRatio: false,
         ⍝H       animation: false,
         ⍝H       layout: { padding: { left: 10, right: 10, top: 5, bottom: noXY ? 30 : 10 } },
         ⍝H       plugins: {
         ⍝H         legend: { display: ["pie","doughnut"].includes(spec.type) },
         ⍝H         title: {
         ⍝H           display: !!spec.title,
         ⍝H           text: spec.title || "",
         ⍝H           font: { size: 25, weight: "bold" }
         ⍝H         },
         ⍝H         tooltip: { callbacks: { label: ctx => ctx.formattedValue } }
         ⍝H       },
         ⍝H       scales: scales
         ⍝H     };
         ⍝H     if (big) {
         ⍝H       options.parsing = false;
         ⍝H       options.normalized = true;
         ⍝H       if (isLine) options.plugins.decimation =
         ⍝H           { enabled: true, algorithm: "lttb", samples: 500 };
         ⍝H     }
         ⍝H
         ⍝H     const chart = new Chart(host.querySelector("canvas"), {
         ⍝H       type: spec.type,
         ⍝H       data: { labels: spec.labels, datasets: [ds] },
         ⍝H       options: options
         ⍝H     });
         ⍝H     return {
         ⍝H       chart: chart,
         ⍝H       start: function () {
         ⍝H         if (canAnim) {
         ⍝H           delayed = false;
         ⍝H           chart.options.animation = animCfg;
         ⍝H           chart.reset();
         ⍝H         }
         ⍝H         host.style.visibility = "visible";
         ⍝H         if (canAnim) chart.update();
         ⍝H       }
         ⍝H     };
         ⍝H   }
         ⍝H   </script>
         ⍝
         ⍝H    <script>
         ⍝H      var spec = _PARMS_;
         ⍝H      var ctl = DrawChart(spec, "chart");
         ⍝H      var started = false;
         ⍝H      function StartChart() {
         ⍝H          if (started) return;
         ⍝H          started = true;
         ⍝H          if (ctl) ctl.start();
         ⍝H      }
         ⍝H      // APL calls StartChart() once the window is visible; this is only a fallback.
         ⍝H      setTimeout(StartChart, 1500);
         ⍝H    </script>
         ⍝H   </body>
         ⍝H  </html>
      ⍝ :EndSection Html/JavaScript Code
