FmtCode←{
  pats← (
    '^\h{0,20}⍝.*'    ⍝ Left-hand comment
    '^\h*'          ⍝ Start of line and spaces
    '(?i):(Namespace|Section|If|For|Select|While|Trap)'
    '(?i):(Else|Case).*'
    '(?i):End'
    '''[^'']*'''    ⍝ Quote
    '⍝.*'           ⍝ Comment
    '^\h*∇\h*$'     ⍝ Starts tradfn 
    '^\h*∇'         ⍝ Ends tradfn
    '[[{(]'         ⍝ Left brace, paren, bracket
    '[]})]'         ⍝ Rght brace, paren, bracket
    ':'             ⍝ Colon of guard, directive
    '←(?!\h)'       ⍝ Assignment NOT followed by spaces
  )
⍝ This is a test.
  lhCI nlI dirOnI dirMoreI dirOffI qtI cmI trdOnI trdOffI brkLI brkRI colonI arrowLI← ⍳≢pats 
  cur mul← () ()
  ⍝ This is too.
  cur.( trd in colon cmL dir dir1 )← 0 
  mul.( trd in colon cmL dir )← 3 5 ¯2 ¯2 3 
  mul.(dir1← -dir)
  indent← ⍬ 
  pad← ⍬
  Scan← pats ⎕R {
      Case← ⍵.PatternNum∘∊
      f0← ⍵.Match
    Case lhCI:    ⎕←f0↓⍨ +/∧\f0=' '⊣ New⍬⊣ cur.cmL⊢← 1 
    Case nlI:     ''⊣ New⍬
    Case qtI cmI: f0
    Case colonI:  f0⊣ Cur⍬⊣ cur.colon⊢← 1 
    Case arrowLI: f0, ' ' 
    Case trdOnI:  f0⊣ cur.trd⊢← 1 ⊣ Cur⍬    
    Case trdOffI: f0⊣ Cur⍬⊣ cur.trd⊢← 0  
    Case dirOnI:  f0⊣ cur.dir+← 1⊣ Cur⍬ 
    Case dirMoreI:f0⊣ Cur⍬⊣ cur.dir1⊢← 1  
    Case dirOffI: f0⊣ Cur⍬⊣ cur.dir-←  1
    Case brkLI:   f0⊣ Cur⍬⊣ cur.in+←  1 ⊣ Cur⍬ 
    Case brkRI:   f0⊣ Cur⍬⊣ cur.in-←  1
      'Logic Error' ⎕SIGNAL 911
   }  
   New←{
    0⊣ indent,← ⊂Indent ⍬
   } 
   Cur← {
    ⍬⊣ (⊃⌽indent)⊢← Indent ⍬
   }
   Indent←{
     pos5← cur.( trd in colon cmL dir dir1 )
     cur.(colon cmL dir1)⊢← 0 0 0
    ∧/ 0= pos5: ''
      ''⍴⍨ 0⌈ +/ pos5× mul.( trd in colon cmL dir dir1)
   }
   indent,¨Scan ⍵ 
}